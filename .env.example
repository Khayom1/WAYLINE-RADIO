POSTGRES_PASSWORD=replace-with-a-strong-unique-password
API_HOST_PORT=8080
PUBLIC_DOMAIN=localhost

# Generate both Icecast passwords as random hexadecimal strings (at least 32 bytes each).
ICECAST_SOURCE_PASSWORD=replace-with-random-64-character-hex
ICECAST_ADMIN_PASSWORD=replace-with-another-random-64-character-hex
BROADCAST_POLL_MS=15000
BROADCAST_BITRATE=128k
MEDIA_DIR=/var/wayline-media
DATABASE_URL=postgresql://wayline:change-me@db:5432/wayline
PORT=8080
NODE_ENV=production
PUBLIC_BASE_URL=https://radio.example.com
ICECAST_INTERNAL_URL=http://icecast:8000
CORS_ORIGIN=https://radio.example.com
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_TTL_SECONDS=43200
AUTO_MIGRATE=true

# RSS / Atom information collection
COLLECTOR_INTERVAL_MS=300000
COLLECTOR_MAX_ITEMS_PER_SOURCE=25

# Optional multilingual TTS provider. Without a key, audio generation stays disabled.
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_TG=alloy
TTS_VOICE_RU=alloy
TTS_VOICE_EN=alloy
TTS_OUTPUT_DIR=/var/wayline-tts
